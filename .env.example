# INDIGO QUANT Environment Configuration Example
# Copy this file to .env and customize as needed. Never commit .env to version control.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Database Connection (Default: persistent SQLite with WAL mode)
DATABASE_URL=sqlite:///./data/indigo_quant.db

# Timezone (MANDATORY: Asia/Kolkata for Indian equity markets)
TIMEZONE=Asia/Kolkata

# Market Data Providers
# TejHQ (Free keyless tier supported; optional free tier API key)
TEJHQ_BASE_URL=https://api.tejhq.dev
TEJHQ_API_KEY=

# Yahoo Finance fallback configuration
YAHOO_FINANCE_TIMEOUT=15
DATA_CACHE_TTL_HOURS=12

# Optional Telegram Notifications for BUY signals
# If left empty, Telegram notifications are disabled safely with no errors
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Ports
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Virtual Capital per Strategy (Default: ₹1,00,000)
INITIAL_STRATEGY_CAPITAL=100000.0
